{
  "layer": "top",
  "position": "top",
  "height": 24,
  "margin-top": 0,
  
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "tray"],

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "1": "I",
      "2": "II",
      "3": "III",
      "4": "IV",
      "5": "V",
      "6": "VI",
      "7": "VII",
      "default": "—"
    }
  },

  "clock": {
    "format": "{:%I · %M}", 
    "format-alt": "{:%A · %d %B}",
    "tooltip": false 
  },

  "pulseaudio": {
    "format": "{volume}",
    "tooltip": false
  },

  "tray": {
    "icon-size": 15,
    "spacing": 10 
  }
}
