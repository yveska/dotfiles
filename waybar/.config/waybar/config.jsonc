{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0, 

  "modules-left": ["hyprland/workspaces", "custom/sep"],
  "modules-center": ["clock"],
  "modules-right": ["custom/vpn", "pulseaudio", "cpu", "group/drawer"],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": true,
    "sort-by-number": true,
    "format-icons": {
      "default": "u"
    }
  },

  "custom/sep": {
    "format": "> < >",
    "tooltip": false
  },

  "custom/vpn": {
      "interval": 5,
      "exec": "nmcli -t -f name,device connection show --active | grep -q 'proton' && echo '{\"text\": \"vpn\", \"class\": \"connected\"}' || echo '{\"text\": \"vpn\", \"class\": \"disconnected\"}'",
      "return-type": "json",
      "tooltip": true,
      "exec-tooltip": "nmcli -t -f name,device connection show --active | grep -q 'proton' && echo 'Connected' || echo 'Disconnected'", 
  },

  "clock": {
    "format": "{:%H:%M  %A, %d}" 
  },

  "cpu": {
    "format": "cpu: {usage}%",
    "on-click": "kitty -e btop",
    "tooltip": false 
  },

  "pulseaudio": {
    "format": "vol: {volume}%",
    "on-click": "pavucontrol",
    "tooltip": false 
  },

  "group/drawer": {
    "orientation": "horizontal",
    "drawer": {
        "transition-duration": 500,
        "children-class": "tray-child",
        "transition-left-to-right": false
    },
    "modules": [
        "custom/tray-handle",
        "tray"
    ] 
  },

  "custom/tray-handle": {
    "format": "󰍜",
    "tooltip": false   
},

  "tray": {
    "icon-size": 16,
    "spacing": 10 
  }
}
