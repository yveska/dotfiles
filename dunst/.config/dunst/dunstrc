[global]
font = "JetBrains Mono Nerd Font 10"
geometry = "320x90-10+10"
transparency = 8
frame_width = 2
separator_height = 2
sticky_history = yes
shrink = true
padding = 12
corner_radius = 6  # if your compositor supports it

# ===========================
# Low Urgency Notifications
# ===========================
[urgency_low]
background = "#0f1a1c"        # kitty background
foreground = "#a6b79c"        # kitty foreground
frame_color = "#1b2a2d"       # kitty color0, subtle border
separator_color = "#2a3b3f"   # kitty selection_background
timeout = 5

# ===========================
# Normal Urgency Notifications
# ===========================
[urgency_normal]
background = "#2a3b3f"        # kitty selection_background, deeper
foreground = "#d3e2c7"        # bright white (#15)
frame_color = "#4f7c82"       # kitty color4 (blue-teal)
separator_color = "#6f9ea3"   # kitty color12 (bright blue-teal)
timeout = 10

# ===========================
# Critical Notifications
# ===========================
[urgency_critical]
background = "#9f6f6c"        # kitty color1 (muted moss-rose)
foreground = "#d3e2c7"        # bright white
frame_color = "#b07c78"       # kitty color9 (bright red)
separator_color = "#b07c78"   # match frame
timeout = 0

# ===========================
# Icons
# ===========================
[icon_theme]
icon_size = 32
